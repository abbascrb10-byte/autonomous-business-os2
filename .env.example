# General Application Settings
APP_NAME=GPIE Professional v1
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=dev_secret_key_change_in_production_123456789

# Database Settings
POSTGRES_USER=gpie
POSTGRES_PASSWORD=gpie_password
POSTGRES_DB=gpie_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://gpie:gpie_password@localhost:5432/gpie_db
SYNC_DATABASE_URL=postgresql://gpie:gpie_password@localhost:5432/gpie_db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Provider Credentials (Optional: system falls back gracefully if unconfigured)
AI_PROVIDER=openai  # openai | anthropic | gemini | mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Merchant Credentials (Optional: real API when configured, isolated test adapter if empty)
AMAZON_ASSOCIATE_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_REGION=us-east-1

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=

# Outreach Provider Settings (Optional: messages held at approval boundary if unconfigured)
OUTREACH_PROVIDER=local_approval  # local_approval | mock | sendgrid | twilio
OUTREACH_API_KEY=

# Base Tracking URL
BASE_TRACKING_URL=http://localhost:8000/api/v1/tracking/click
