# General Application Settings
APP_NAME=GPIE Professional v1
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=dev_secret_key_change_in_production_123456789
ADMIN_API_KEY=replace-with-a-long-random-value

# Database Settings
POSTGRES_USER=gpie
POSTGRES_PASSWORD=gpie_password
POSTGRES_DB=gpie_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://gpie:gpie_password@localhost:5432/gpie_db
SYNC_DATABASE_URL=postgresql://gpie:gpie_password@localhost:5432/gpie_db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Provider Credentials (Default: Ollama local model)
AI_PROVIDER=ollama  # ollama | gemini | openai | anthropic | mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Cloud LLM Credentials
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Tavily Web Search API (Free Tier)
TAVILY_API_KEY=

# Demand Sources
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=

# Primary Real Commerce Credentials: eBay
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=

# Primary Real Commerce Credentials: Etsy
ETSY_API_KEY=
ETSY_SHOP_ID=

# Optional Commerce Credentials: Amazon
AMAZON_ASSOCIATE_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_REGION=us-east-1

# Outreach Provider Settings
OUTREACH_PROVIDER=local_approval  # local_approval | sendgrid | twilio
OUTREACH_API_KEY=

# Base Tracking URL
BASE_TRACKING_URL=http://localhost:8000/api/v1/tracking/click
